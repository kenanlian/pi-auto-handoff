{
  "name": "pi-auto-handoff",
  "version": "0.1.0",
  "private": true,
  "description": "Pi 0.85.x extension: threshold + work-package-boundary auto handoff without changing process or logical session.",
  "type": "module",
  "keywords": ["pi-package"],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
